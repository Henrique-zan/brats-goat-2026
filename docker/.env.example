# Copy to .env and fill in your values.

# Full image name. For Synapse it MUST be:
#   docker.synapse.org/<PROJECT_ID>/<image-name>:<tag>
IMAGE=docker.synapse.org/synXXXXXXX/brats-goat-2026:v1

# Absolute host paths (use the provided GoAT validation set for local testing).
INPUT_DIR=/absolute/path/to/input
OUTPUT_DIR=/absolute/path/to/output

# Challenge compute limits (segmentation tasks 1-3).
MEMORY_LIMIT=48g
SHM_SIZE=16g
